# Postgres connection string (Neon).
# Local dev: use your Neon "dev" branch. Vercel: set this in Project Settings > Environment Variables.
# Never commit the real value. Copy this file to .env.local and fill it in.
DATABASE_URL="postgresql://user:password@host.neon.tech/dbname?sslmode=require"

# Path to the source EA FC 26 CSV used by scripts/import-players.ts.
# Only needed when regenerating data/pl-players.csv from the full export.
FC_CSV_PATH="/Users/Vidit/Downloads/FC26_20250921.csv"
