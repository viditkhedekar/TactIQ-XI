# Postgres connection string.
#
# Local development: a Postgres running on your machine is fine, for example
#   postgresql://YOUR_USER@localhost:5432/footballmanager
# Production: any managed Postgres (Neon, Supabase, Vercel Postgres). Set the
# value in the hosting provider's environment variables, never in the repo.
#
# Copy this file to .env.local and fill it in. .env.local is gitignored.
DATABASE_URL="postgresql://user:password@localhost:5432/footballmanager"

# Path to the full EA FC 26 export. Only needed to regenerate
# data/pl-players.csv from source; the committed slice is enough to play.
FC_CSV_PATH="/path/to/FC26_export.csv"
